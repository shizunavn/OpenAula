{
  "name": "openhero68-ui",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "build:landing": "node tools/build-landing.mjs",
    "package:landing": "node tools/build-landing.mjs --package",
    "check:landing": "node tools/check-landing.mjs",
    "preview:landing": "node tools/preview-landing.mjs",
    "typecheck:service": "tsc --project service/tsconfig.json --noEmit",
    "build:service": "tsc --project service/tsconfig.json && node service/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:rgb": "node --test tests/rgb.test.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cf:dev": "npm run build && npx wrangler@4 dev",
    "cf:deploy": "npm run build && npx wrangler@4 deploy",
    "pages:deploy": "npm run build && npx wrangler@4 pages deploy dist --project-name open-aula --branch main",
    "test:profile-remap": "node --test tests/profile-remap.test.mjs",
    "prepare:setup": "node tools/prepare-setup-tools.mjs",
    "build:setup": "npm run build:service && node tools/package-service-setup.mjs",
    "sign:setup": "node tools/sign-service-setup.mjs",
    "verify:setup": "node tools/verify-service-setup.mjs",
    "test:setup": "node tools/smoke-service-setup.mjs"
  },
  "dependencies": {
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "rolldown": "1.2.9",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
